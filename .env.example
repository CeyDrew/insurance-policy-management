# Copy to .env and change the values. .env is git-ignored.

# Oracle (docker compose)
ORACLE_PASSWORD=change_me_sys
ORACLE_PORT=1521
ORACLE_HOST=localhost
ORACLE_SERVICE=FREEPDB1
# Time zone of the database server (SYSTIMESTAMP); keep it equal to the application time zone
ORACLE_TZ=Europe/Istanbul

# Application schema (created automatically by gvenzl/oracle-free on first start)
APP_USER=insurance
APP_USER_PASSWORD=change_me_app

# JWT signing key: Base64-encoded, at least 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_me_base64_secret

# Full stack (docker compose up --build): published ports. Nightly batch scheduling is on there by default.
BACKEND_PORT=8080
FRONTEND_PORT=4200
